<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="@drawable/card_white_rounded"
    android:elevation="2dp"
    android:orientation="vertical"
    android:padding="16dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tv_admin_req_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Electrical Issue"
            android:textColor="@color/navy_onserve"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_delete_request"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="Delete Request"
                android:src="@drawable/ic_delete" />

            <TextView
                android:id="@+id/tv_admin_emergency_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/emergency_card_bg"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="EMERGENCY"
                android:textColor="@color/red_emergency"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_admin_req_user"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginTop="5dp"
            android:text="User: patrick@email.com"
            android:textColor="@color/text_gray"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_admin_req_booked_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Booked: ASAP"
            android:textColor="@color/blue_onserve"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_admin_req_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Description goes here..."
        android:textColor="@color/navy_onserve"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/layout_admin_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="@color/gray_border" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Date &amp; Time Submitted"
            android:textColor="@color/text_gray"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_admin_submitted_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Oct 24, 2023"
            android:textColor="@color/navy_onserve"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Requesting User"
            android:textColor="@color/text_gray"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_admin_req_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Full Name"
            android:textColor="@color/navy_onserve"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Email Address"
            android:textColor="@color/text_gray"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_admin_req_email"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="email@example.com"
            android:textColor="@color/navy_onserve"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Contact Number"
            android:textColor="@color/text_gray"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_admin_req_phone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0912 345 6789"
            android:textColor="@color/navy_onserve"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

    <TextView
        android:id="@+id/btn_admin_show_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="8dp"
        android:text="Show more"
        android:textColor="@color/blue_onserve"
        android:textSize="12sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="12dp"
        android:background="@color/gray_border" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Set Priority:"
        android:textColor="@color/navy_onserve"
        android:textSize="14sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rg_priority"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rb_p1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="P1: Emergency"
            android:textSize="12sp"
            android:buttonTint="@color/red_emergency"
            android:textColor="@color/black" />

        <RadioButton
            android:id="@+id/rb_p2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="P2: Urgent"
            android:textSize="12sp"
            android:buttonTint="@color/blue_onserve"
            android:textColor="@color/black" />

        <RadioButton
            android:id="@+id/rb_p3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="P3: Routine"
            android:textSize="12sp"
            android:buttonTint="@color/text_gray"
            android:textColor="@color/black" />
    </RadioGroup>

    <LinearLayout
        android:id="@+id/layout_expertise_selection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Filter Volunteer Expertise:"
            android:textColor="@color/navy_onserve"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinner_expertise"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/input_rounded"
            android:paddingHorizontal="10dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_sub_priority"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Sub-Level:"
            android:textColor="@color/navy_onserve"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinner_sub_priority"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/input_rounded"
            android:paddingHorizontal="10dp" />
    </LinearLayout>

    <android.widget.Button
        android:id="@+id/btn_confirm_booking"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="15dp"
        android:background="@drawable/button_navy_rounded"
        android:text="Confirm Booking"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textStyle="bold" />

</LinearLayout>