<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/light_gray_bg">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@color/navy_onserve"
        android:paddingHorizontal="24dp">

        <FrameLayout
            android:id="@+id/btn_back_priority"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_back_arrow"
                android:padding="8dp"
                app:tint="@color/white"
                android:contentDescription="Back" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Priority Overview"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- EMERGENCY -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_white_rounded"
                android:orientation="vertical"
                android:padding="16dp"
                android:elevation="2dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EMERGENCY (Life &amp; Safety)"
                    android:textColor="#C62828"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="#C62828"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sub-Level 1: Life-Threatening (Rescue)"
                    android:textStyle="bold"
                    android:textColor="@color/navy_onserve" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Immediate intervention needed to save lives from active peril (e.g., trapped individuals)."
                    android:textSize="13sp"
                    android:textColor="@color/text_gray"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sub-Level 2: Active Environmental Hazard"
                    android:textStyle="bold"
                    android:textColor="@color/navy_onserve" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ongoing hazards threatening life or property (e.g., house fires, major gas leaks)."
                    android:textSize="13sp"
                    android:textColor="@color/text_gray"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sub-Level 3: Immediate Health Crisis"
                    android:textStyle="bold"
                    android:textColor="@color/navy_onserve" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Critical injuries or severe medical emergencies requiring instant first aid."
                    android:textSize="13sp"
                    android:textColor="@color/text_gray" />
            </LinearLayout>

            <!-- URGENT -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_white_rounded"
                android:orientation="vertical"
                android:padding="16dp"
                android:elevation="2dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="URGENT (Stability &amp; Survival)"
                    android:textColor="#FFBF00"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="#FFBF00"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sub-Level 1: Major Structural Damage"
                    android:textStyle="bold"
                    android:textColor="@color/navy_onserve" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Damaged structures that are unstable but not in immediate collapse (e.g., roof damage)."
                    android:textSize="13sp"
                    android:textColor="@color/text_gray"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sub-Level 2: Resource/Utility Depletion"
                    android:textStyle="bold"
                    android:textColor="@color/navy_onserve" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Critical lack of essential resources (e.g., complete water loss, food shortage)."
                    android:textSize="13sp"
                    android:textColor="@color/text_gray"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sub-Level 3: Access &amp; Extraction"
                    android:textStyle="bold"
                    android:textColor="@color/navy_onserve" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Blocked access to essential supplies or minor extractions from non-lethal situations."
                    android:textSize="13sp"
                    android:textColor="@color/text_gray" />
            </LinearLayout>

            <!-- ROUTINE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_white_rounded"
                android:orientation="vertical"
                android:padding="16dp"
                android:elevation="2dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ROUTINE (Recovery &amp; Assistance)"
                    android:textColor="#2E7D32"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="#2E7D32"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sub-Level 1: Sanitation &amp; Biohazard"
                    android:textStyle="bold"
                    android:textColor="@color/navy_onserve" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Minor leaks or sanitation issues that don't pose immediate health threats."
                    android:textSize="13sp"
                    android:textColor="@color/text_gray"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sub-Level 2: General Repair &amp; Restoration"
                    android:textStyle="bold"
                    android:textColor="@color/navy_onserve" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Non-essential property repairs or debris clearance."
                    android:textSize="13sp"
                    android:textColor="@color/text_gray"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sub-Level 3: Supply &amp; Info Request"
                    android:textStyle="bold"
                    android:textColor="@color/navy_onserve" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Informational queries or non-urgent supply requests (e.g., wellness checks)."
                    android:textSize="13sp"
                    android:textColor="@color/text_gray" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
